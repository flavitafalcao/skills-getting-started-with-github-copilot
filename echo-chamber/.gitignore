# .gitignore for Echo Chamber

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*

# Build and dist
dist/
build/

# Temporary files
tmp/
temp/
*.tmp

# Test coverage
coverage/
.nyc_output/
